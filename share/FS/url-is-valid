#: FUNCTION ^[-or-warn^|-or-die^|-or-false^] ^Uurl^u
#: Validate with `curl` that a url will work.

needs setWarnOrDie warnOrDie curl
function url-is-valid {
	local rc
	[[ ${1:-} == -* ]]&& {
		setWarnOrDie "$1"
		shift
	  }
	(($#))|| die 'Missing required parameter ^Uurl^u.'
	rc=$(curl -LsIw "%{response_code}" --http2 "$1" --out-null
	[[ $rc == 200 ]]|| warnOrDie "^B$1^b: ^B$rc^b"
}

