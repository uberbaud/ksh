#: FUNCTION
#:   Wrapper around prj.ksh for ^Tcd^t.

needs awk h3 tty $BS/prj.ksh
function f-prj {
	local D P S X tty CD cmd
	X=${BS:?}/prj.ksh
	CD=false
	D=$HOME/projects

	if (($#==0)); then							# no args
		cmd=ls									#	default to `ls`
		[[ ${PWD#$D} != $PWD ]]&& cmd=curprj	#	unless in prj dir, then
	elif [[ ${1:-} == @(-h|help) ]]; then		# help
		cmd=help; shift
	elif "$X" -c "$1"; then						# $1 is a valid sub-command
		cmd=$1; shift
	else										# try `cd`ing to $1
		cmd=cd
	fi

	case $cmd in
		cd)  cmd=find; CD=true;			;;
		new) CD=true;					;;
	esac

	tty=$(tty)
	if $CD; then
		P=$(TTY=$tty "$X" "$cmd" "$@") || return
		S=$(awk -F'\\\| *' '/^summary / {print $2}' "$D/$P"/PROJECT)
		h3 "$P / $S"
		[[ -n $P ]]&& { cd "$D/$P"; ls; }
	else
		TTY=$tty "$X" "$cmd" "$@"
	fi
}

