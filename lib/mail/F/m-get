#: FUNCTION ^G(no arguments)^g
#:   Wrapper around ${MAIL_APP_PATH:?}/B/_get.ksh "$@"

function generate-tag {
	set -A alph -- a b d e f g h j k m n o p q r s t w y z
	set -- $(date -u +'%y %j')
	REPLY=${alph[$1%20]}${alph[$2/20]}${alph[$2%20]}
}

function update-prefix-and-file {
	generate-tag					# sets REPLY
	if [[ -s .batch ]]; then
		local oldprefix tag num
		oldprefix=$(<.batch)
		num=${oldprefix#???}
		tag=${oldprefix%"$num"}
		# REPLY is from generate-tag, missing num (0)
		#   if old and new are the same use the already incremented 
		#   oldprefix, plus don't update .batch
		[[ $tag == $REPLY ]]&& PREFIX=$oldprefix return
	fi
	PREFIX=${REPLY}0			# from generate-tag, missing num (0)
	print -r -- "$PREFIX" >.batch
}

function m-get {
	local REPLY
	((LOGLEVEL))&&
		PREMAIL_LOGLEVEL=${PREMAIL_LOGLEVEL:-${LOGLEVEL:-}}
	export LOGLEVEL=0
	PRE_MAIL_PWD=${PRE_MAIL_PWD:-$PWD}
	builtin cd ${XDG_PUBLICSHARE_DIR:?}/mail
	update-prefix-and-file
	${MAIL_APP_PATH:?}/B/_get.ksh "$@"
}


