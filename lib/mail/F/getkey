#: FUNCTION ^Ukey list^u ^[^Uvarname^u^]
#:   Wait for specific key hits and return that in ^O${^o^V2^v^O:-^o^VREPLY^v^O}^o

needs read-one-key
function getkey {
	local keylist varname
	keylist=${1:?Missing keylist parameter}
	varname=${2:-REPLY}
	set -- $(read-one-key)
	while [[ $1-$2 != c-[$keylist] ]]; do
		set -- $(read-one-key)
	done
	eval $varname=\$2
}

