#: FUNCTION ^G(no arguments)^g
#:   Wraps ^Tapropos^t with a pipe to less

# -e | --quit-at-eof				# second time it gets there
# -F | --quit-if-one-screen
# -g | --hilite-search				# only highlight the *current* find
# -i | --ignore-case				# use case only if some UPPER
# -M | --LONG-PROMPT				# most verbose prompt
# -R | --RAW-CONTROL-CHARS			# pass through ANSI color sequences
# -S | --chop-long-lines
# -s | --squeeze-blank-lines
# -w | --hilite-unread
# -X | --no-init					# don't clear screen or other stuff

function f-apropos {
	/usr/bin/apropos "$@" | LESS=-eFgiMRSswX ${PAGER:-less}
}

