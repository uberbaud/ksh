#: FUNCTION
#:   Wrap ^Tqc^t ^BOR^b ^Tbuild-and-run -e^t.

function f-qc {
	if [[ -n ${1:-} && -e ${1%.c}.c ]]; then
		build-and-run -e "$@"
	else
		command qc "$@"
	fi
}

