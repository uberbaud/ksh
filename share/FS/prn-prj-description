#: FUNCTION
#:   Prints current project description according to ^O$^o^VPWD^v, if in 
#:   a project file.

needs in-ancestor-path
function prn-prj-description {
	local REPLY
	in-ancestor-path PROJECT &&
		print -r -- "$(<$REPLY)"
}

