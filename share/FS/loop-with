#: FUNCTION ^Ucmd^u ^[^Uarg1^u ^S…]^s
#:   loop a cmd

function loop-with {
	whence ${1:?} >/dev/null || die "^T$1^t is not a valid command."
	while :; do
		("$@")
		(($?>127)) && break # exit on signals
	done
}

