#: FUNCTION ^Unew_directory^u
#:   ^Tmkdir -p^t ^Unew_path^u, and then ^Tcd^t there.

function mcd {
	: ${1:?Missing required parameter NEW DIRECTORY}
	(($#==1))|| die 'Too many arguments.'
	mkdir -p "$1" && builtin cd "$1" || return
  }

