#: FUNCTION ^G(no arguments)^g
#:   Amuse utility. Puts just played (in ^Tplaying^t) at the HEAD of 
#:   ^Tplayed.lst^t AND truncates ^Tplaying^t.

function move-played-to-history {
	local PlayedBuf PlayingBuf NL='
'
	PlayingBuf=$(<playing)
	: >playing
	PlayedBuf=$(head -n200 played.lst)
	print -r -- "$PlayingBuf$NL$PlayedBuf" >played.lst
}

