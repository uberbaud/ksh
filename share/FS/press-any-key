#: FUNCTION ^[^Umessage^u^] ^= ^VREPLY^v
#:   Waits for ANY key press.
#:   ^VREPLY^v is set to the ^Bkey-class-char^b and the ^Bkey-name^b.

needs read-one-key
function press-any-key {
	REPLY=

	print -- ${1:-Press ANY key.}
	set -- $(read-one-key 2>&1) || { warn "$*"; return; }

	REPLY=$1-$2
}

