#: FUNCTION ^[^T-e^t^] …
#:   Wrap ^Tqc.ksh^t ^BOR^b ^Tbuild-and-run -e^t depending on whether 
#:   ^T-e^t is the first argument passed.
#:
#: FUNCTION ^[^T-v^t^] ^[^Ufilename^u^ ^[^Upkg_name^u ^S…]^s^]
#: 	 Wrap ^Tqc.ksh^t
#:
#: FUNCTION ^T-e^t ^[^Ufilename^u^]
#: 	 Wrap ^Tbuild-and-run^t

function f-qc {
	if [[ ${1:-} == -e ]]; then
		needs build-and-run
		build-and-run "$@"
	elif [[ ${1:-} == -h ]]; then
		notify	'Use ^Thelp f-qc^t,'		\
				' or ^T\qc.ksh -h^t,'		\
				' or ^Tbuild-and-run -h^t.'
	else
		needs qc.ksh
		qc.ksh "$@"
	fi
}

