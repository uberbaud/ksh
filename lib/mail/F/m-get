#: FUNCTION ^G(no arguments)^g
#:   Wrapper around $BS/m-get.ksh

function create-batch-file {
	local tag
	set -A alph -- a b d e f g h j k m n o p q r s t w y z
	set -- $(date -u +'%y %j')
	tag=${alph[$1%20]}${alph[$2/20]}${alph[$2%20]}
	print -r -- "${tag}0" >.batch
}

function m-get {
	((LOGLEVEL))&&
		PREMAIL_LOGLEVEL=${PREMAIL_LOGLEVEL:-${LOGLEVEL:-}}
	export LOGLEVEL=0
	PRE_MAIL_PWD=${PRE_MAIL_PWD:-$PWD}
	builtin cd ${XDG_PUBLICSHARE_DIR:?}/mail
	[[ -s .batch ]]|| create-batch-file # don't if non-empty file exists
	${MAIL_APP_PATH:?}/B/_get.ksh "$@"
	PREFIX=$(<.batch)
}

