#: FUNCTION ^G(ci arguments)^g
#:   wrapper around ci with rcsdiff and -u

needs needs-file
function f-ci {
	local file
	(($#))|| die "Missing required parameter: file"
	for file { :; }
	needs-file -or-die "$file"
	command rcsdiff -q "$file"
	command ci -q -u "$@"
}

